# ── Clerk ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Asaas (Pagamentos) ──
ASAAS_ENV=sandbox
ASAAS_API_KEY=...
ASAAS_WEBHOOK_TOKEN=...

# ── Web Push (VAPID) ──
# Gerar: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:contato@kathapp.com

# ── Frete / Shipping ──
# Melhor Envio (nacional) — https://melhorenvio.com.br/painel/gerenciar/tokens
MELHOR_ENVIO_TOKEN=...
MELHOR_ENVIO_ENV=sandbox

# 99 Entrega (entregas locais)
ENTREGA99_API_KEY=...

# Lalamove (entregas locais) — https://developers.lalamove.com
LALAMOVE_API_KEY=...
LALAMOVE_API_SECRET=...

# Endereço de origem dos pedidos
SHIPPING_ORIGIN_ZIP=22790700
SHIPPING_ORIGIN_CITY=Rio de Janeiro
SHIPPING_ORIGIN_STATE=RJ
SHIPPING_ORIGIN_ADDRESS=Avenida das Américas, 19000 - Recreio dos Bandeirantes

# ── Redis (Railway) — rate limiting em produção ──
# Criar Redis no Railway: railway.app → New Service → Redis
REDIS_URL=redis://default:xxx@host:port

# ── Pix Manual (fallback quando Asaas não configurado) ──
PIX_KEY=sua-chave-pix
PIX_NAME=KathApp

# ── Sentry (Opcional) ──
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_AUTH_TOKEN=...

# ── Vercel Cron ──
CRON_SECRET=...
